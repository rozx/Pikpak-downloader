{
  "name": "pikpak-downloader",
  "version": "0.7.1",
  "author": "rozx",
  "homepage": "https://github.com/rozx/Pikpak-downloader",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --watch src/cli.ts",
    "start": "bun src/cli.ts",
