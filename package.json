  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ink": "8.0.0",
    "react": "19.3.1"
  }
}
